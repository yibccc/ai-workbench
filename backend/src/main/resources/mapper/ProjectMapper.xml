<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiworkbench.mapper.ProjectMapper">
    <resultMap id="projectRow" type="com.aiworkbench.entity.project.ProjectRow">
        <constructor>
            <arg column="id" javaType="java.util.UUID"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="archived_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>
    <sql id="columns">id, name, status, archived_at, created_at, updated_at</sql>
    <insert id="insert">
        INSERT INTO projects (id, name) VALUES (#{id}, #{name})
    </insert>
    <select id="findById" resultMap="projectRow">
        SELECT <include refid="columns"/> FROM projects WHERE id = #{id}
    </select>
    <select id="findAll" resultMap="projectRow">
        SELECT <include refid="columns"/> FROM projects
        <if test="!includeArchived">WHERE status = 'ACTIVE'</if>
        ORDER BY created_at DESC, id DESC
    </select>
    <sql id="pageWhere">
        <where>
            <if test="!includeArchived">status = 'ACTIVE'</if>
            <if test="q != null and q != ''">
                <if test="!includeArchived">AND</if> lower(name) LIKE '%' || lower(#{q}) || '%'
            </if>
        </where>
    </sql>
    <select id="findPage" resultMap="projectRow">
        SELECT <include refid="columns"/> FROM projects <include refid="pageWhere"/>
        ORDER BY created_at DESC, id DESC
    </select>
    <update id="rename">
        UPDATE projects SET name = #{name}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>
    <update id="archive">
        UPDATE projects SET status = 'ARCHIVED', archived_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id} AND status = 'ACTIVE'
    </update>
</mapper>
