    <arg column="session_id" javaType="java.util.UUID" typeHandler="com.aiworkbench.config.mybatis.UuidTypeHandler"/>
    <arg column="user_id" javaType="java.util.UUID" typeHandler="com.aiworkbench.config.mybatis.UuidTypeHandler"/>
