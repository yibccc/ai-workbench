  <resultMap id="receipt" type="com.aiworkbench.entity.interview.InterviewRows$ReceiptRow"><constructor>
    <arg column="user_id" javaType="java.util.UUID" typeHandler="com.aiworkbench.config.mybatis.UuidTypeHandler"/>
    <arg column="operation" javaType="java.lang.String"/>
    <arg column="request_id" javaType="java.util.UUID" typeHandler="com.aiworkbench.config.mybatis.UuidTypeHandler"/>
