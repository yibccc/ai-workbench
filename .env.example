# Copy to .env for Docker Compose. Never commit real credentials.
POSTGRES_DB=ai_workbench
POSTGRES_USER=ai_workbench
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Private local RustFS. Generate separate random management and application identities.
# Initialization: python scripts/local/initialize-storage.py --env-file .env --endpoint http://127.0.0.1:9000 --bucket workbench-community
# The management pair is only for RustFS/initialization, never the backend or frontend.
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=replace_with_management_access_key
RUSTFS_SECRET_KEY=replace_with_management_secret_key
WORKBENCH_STORAGE_PROVIDER=rustfs
WORKBENCH_STORAGE_ENDPOINT=http://127.0.0.1:9000
WORKBENCH_STORAGE_REGION=us-east-1
WORKBENCH_STORAGE_BUCKET=workbench-community
WORKBENCH_STORAGE_ACCESS_KEY=replace_with_application_access_key
WORKBENCH_STORAGE_SECRET_KEY=replace_with_application_secret_key
WORKBENCH_STORAGE_PATH_STYLE=true
WORKBENCH_STORAGE_CONNECT_TIMEOUT=PT2S
WORKBENCH_STORAGE_READ_TIMEOUT=PT30S
WORKBENCH_STORAGE_API_CALL_ATTEMPT_TIMEOUT=PT60S
WORKBENCH_STORAGE_API_CALL_TIMEOUT=PT120S
WORKBENCH_STORAGE_RESERVATION_DURATION=PT5M

# Read by the backend process only. It is intentionally not forwarded to the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
REPORT_AI_TIMEOUT=PT6M
REPORT_AI_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT=PT4M

# Docker frontend bind; set 0.0.0.0 only for an explicitly chosen direct-IP entry.
# Windows local startup uses port 5173 instead.
APP_BIND=127.0.0.1
APP_PORT=8088
# Both Docker and Windows backend use these only when no account exists.
# Used only when the account table is empty. Remove the password after first startup.
WORKBENCH_BOOTSTRAP_USERNAME=
WORKBENCH_BOOTSTRAP_PASSWORD=
# Set true behind HTTPS and a trusted proxy. Loopback HTTP development uses false.
WORKBENCH_COOKIE_SECURE=false
# Exact browser origin(s), comma separated; use http://host-ip:8088 for temporary direct-IP HTTP,
# or https://your-domain for HTTPS.
# Leave unset for Windows development (5173/15173). Compose supplies 8088 defaults.
# WORKBENCH_WS_ALLOWED_ORIGINS=https://workbench.example.com
